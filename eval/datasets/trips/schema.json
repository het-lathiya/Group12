{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-travel-planner:schema:eval-case-v1",
  "title": "EvaluationCase",
  "description": "One line of cases.jsonl (FR-118). request is a frozen gr-1 GenerationRequest (contracts/ai/gr-1.schema.json). Place and destination IDs are UUID v5 values under the namespace uuid5(NAMESPACE_URL, 'urn:ai-travel-planner:sampleton'), named by external_ref or 'sampleton', because seeded rows get random IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "category", "tags", "request", "hard_constraints", "expected_properties"],
  "properties": {
    "id": { "type": "string", "pattern": "^trips-v1-[0-9]{3}$" },
    "version": { "const": "v1" },
    "category": {
      "enum": [
        "standard",
        "tight_budget",
        "step_free_group",
        "must_visit_conflict",
        "pace_extreme",
        "long_trip",
        "day_regeneration",
        "hostile_notes"
      ]
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "request": { "type": "object" },
    "hard_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_free_required",
        "budget_amount",
        "must_visit_place_ids",
        "locked_place_ids",
        "max_items_per_day",
        "max_active_minutes_per_day"
      ],
      "properties": {
        "step_free_required": { "type": "boolean" },
        "budget_amount": { "type": ["string", "null"] },
        "must_visit_place_ids": { "type": "array", "items": { "type": "string" } },
        "locked_place_ids": { "type": "array", "items": { "type": "string" } },
        "max_items_per_day": { "type": "integer" },
        "max_active_minutes_per_day": { "type": "integer" }
      }
    },
    "expected_properties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usable_plan", "conflicts", "notes_change_nothing"],
      "properties": {
        "usable_plan": { "type": "boolean" },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["place_id", "external_ref", "note"],
            "properties": {
              "place_id": { "type": "string" },
              "external_ref": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "notes_change_nothing": { "type": "boolean" }
      }
    }
  }
}
