; Import boundaries of specification §4.4, run by make imports (lint-imports --config .importlinter).
; This file holds the Layers and Vendor isolation rows (IMP-101 step 6, NFR-031). The Pure domain,
; Routing isolation, Service order, Booking and Not-MVP contracts are added by the cards that create
; those modules.

[importlinter]
root_package = app
; Needed so that the vendor SDK (google.genai) appears in the import graph.
include_external_packages = True

; §4.4 Layers: in every module, router may import service; service may import domain and
; repository; domain and repository never import service or router; clients and adapters sit
; at the bottom (CLAUDE.md §4 rule 1). The container app.* picks up every module, including the
; extension modules when they are created. Each layer is optional (in parentheses) because a
; module creates only the files it needs (§4.3); a layer that exists is always checked.
[importlinter:contract:layers]
name = Layers: router > service > domain, repository > client, providers (every module)
type = layers
containers =
    app.*
layers =
    (router)
    (service)
    (domain) : (repository)
    (client) : (providers)

; §4.4 Vendor isolation, first half: google.genai is imported only by app.ai.providers.gemini.
; import-linter sees an external package only by its top-level name, so the rule is written for
; the whole google namespace (google.genai included). The one allowed import is ignored here;
; unmatched_ignore_imports_alerting = none lets the contract pass before gemini.py exists (IMP-207).
; TC-002 (IMP-512): this and the next contract run in make imports, a required CI step (ci.yml);
; tests/contract/test_provider_contract.py repeats the check for app.generation (TC-156).
[importlinter:contract:vendor-sdk]
name = Vendor isolation: google (google.genai) only in app.ai.providers.gemini
type = forbidden
source_modules =
    app
forbidden_modules =
    google
ignore_imports =
    app.ai.providers.gemini -> google
unmatched_ignore_imports_alerting = none

; §4.4 Vendor isolation, second half: concrete adapters are imported only by app.ai.factory.
; Everything else uses app.ai.providers.base, app.ai.errors and app.ai.factory (§8.3). A new
; adapter is added to this list in the card that creates it. The adapters are written as wildcard
; expressions (app.*.providers.<name>, which only app.ai.providers.<name> matches) because
; import-linter accepts a wildcard that matches nothing yet, but not a plain module name that does
; not exist. as_packages = False for the same reason: factory and the adapters are single modules.
[importlinter:contract:vendor-adapters]
name = Vendor isolation: concrete adapters only imported by app.ai.factory
type = protected
protected_modules =
    app.*.providers.gemini
    app.*.providers.groq
    app.*.providers.mock
    app.*.providers.finetuned
allowed_importers =
    app.ai.factory
as_packages = False

; IMD-223: provider HTTP stays inside the two adapters; factory and prompts use the interface.
[importlinter:contract:ai-http]
name = Vendor isolation: AI HTTP only in adapter modules
type = forbidden
source_modules =
    app.ai
forbidden_modules =
    httpx
ignore_imports =
    app.ai.providers.gemini -> httpx
    app.ai.providers.groq -> httpx
allow_indirect_imports = True

; §4.4 Pure domain, first module (IMP-209): app.routing.estimate does no I/O, so it imports no web
; framework, ORM, HTTP client or vendor SDK, nothing from app.db or app.core, and no router,
; service or repository. As agreed in RUN-002, each card that creates a pure module listed in §4.4
; adds it to source_modules here. The wildcards cover the layer modules of every app module,
; including those created later (import-linter accepts a wildcard that matches nothing yet).
[importlinter:contract:pure-domain]
name = Pure domain: listed modules import no framework, I/O, core or layer module
type = forbidden
source_modules =
    app.routing.estimate
    app.generation.ranking
    app.rag.documents
    app.rag.guides
    app.rag.chunker
    app.rag.query
    app.rag.mmr
    app.budget.engine
    app.validation.rules
    app.validation.validator
    app.generation.fallback_planner
    app.generation.grouping
    app.evaluation.retrieval_metrics
    app.livedata.normalise
    app.livedata.countries
forbidden_modules =
    fastapi
    sqlalchemy
    httpx
    google
    app.db
    app.core
    app.*.router
    app.*.service
    app.*.repository

; §4.4 Routing isolation (IMP-307): httpx calls to OpenRouteService only in app.routing.client.
[importlinter:contract:routing-isolation]
name = Routing isolation: httpx only in app.routing.client within app.routing
type = forbidden
source_modules =
    app.routing.service
    app.routing.cache
    app.routing.estimate
forbidden_modules =
    httpx
allow_indirect_imports = True

; A1 §8.2 Service order (IMP-313): the RAG module sits below everything that calls it.
[importlinter:contract:rag-service-order]
name = Service order: app.rag imports no generation, itinerary, budget, validation or evaluation
type = forbidden
source_modules =
    app.rag
forbidden_modules =
    app.generation
    app.itinerary
    app.budget
    app.validation
    app.evaluation

; A2 §8.2 Live-data isolation (IMP-723), one contract with two rules.
; Rule 1: within app.livedata, app.places and app.rag, httpx is imported only by the two real
; adapters, app.livedata.providers.osm (Nominatim, Overpass) and app.livedata.providers.wiki
; (MediaWiki); their two imports are ignored. Indirect imports are allowed, as in
; routing-isolation: app.livedata.factory builds the adapters, and app.rag reaches httpx through
; app.ai.factory and the Gemini adapter, which vendor-sdk already confines.
; Rule 2: app.livedata imports no generation, itinerary, budget, validation, trips or db module; it
; returns data and the places and RAG services store it. That rule is for app.livedata only, so
; the imports of those modules by app.places and app.rag (which own their tables) are ignored
; here; app.rag's imports of generation, itinerary, budget and validation stay forbidden by
; rag-service-order. unmatched_ignore_imports_alerting = none because most of these imports do
; not exist (and must not appear in app.livedata).
[importlinter:contract:livedata-isolation]
name = Live-data isolation: httpx only in the osm and wiki adapters; app.livedata stores nothing
type = forbidden
source_modules =
    app.livedata
    app.places
    app.rag
forbidden_modules =
    httpx
    app.generation
    app.itinerary
    app.budget
    app.validation
    app.trips
    app.db
ignore_imports =
    app.livedata.providers.osm -> httpx
    app.livedata.providers.wiki -> httpx
    app.places.** -> app.db.**
    app.places.** -> app.trips.**
    app.places.** -> app.generation.**
    app.places.** -> app.itinerary.**
    app.places.** -> app.budget.**
    app.places.** -> app.validation.**
    app.rag.** -> app.db.**
    app.rag.** -> app.trips.**
allow_indirect_imports = True
unmatched_ignore_imports_alerting = none
