# Copy to .env.local. Use the public staging values from the repo variables
# STAGING_SUPABASE_URL and STAGING_SUPABASE_ANON_KEY (Settings → Variables).
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>
# Same-origin path: next dev proxies it (next.config.ts); Amplify proxies it on AWS.
NEXT_PUBLIC_API_BASE_URL=/api/v1
