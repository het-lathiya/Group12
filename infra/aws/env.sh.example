# Copy to infra/aws/env.sh (untracked) and replace every <placeholder>. This file holds names only:
# never put a password, key or connection string here. The set-up scripts refuse to run while a
# <placeholder> is left. The blank values at the end are filled in as the guide says.

# ---------- account ----------
export AWS_REGION=ap-south-1
export AWS_DEFAULT_REGION="$AWS_REGION"
export AWS_ACCOUNT_ID="<12-digit AWS account ID>"

# ---------- budget (A1 §4.1, NFR-049) ----------
export BUDGET_NAME=group12-monthly
export BUDGET_ALERT_EMAIL="<team e-mail address for the budget alerts>"

# ---------- database (A1 §4.1) ----------
export RDS_INSTANCE_ID=group12-rds
export RDS_SECURITY_GROUP=group12-rds
export RDS_INSTANCE_CLASS=db.t4g.micro
export RDS_MASTER_USER=group12_owner
export RDS_DB_NAME=travel_staging

# ---------- registry, services and logs ----------
export ECR_API_REPO=group12-api
export ECR_WEB_REPO=group12-web
export ECS_CLUSTER=default
export API_SERVICE=group12-api-staging
export WEB_SERVICE=group12-web-staging
export API_LOG_GROUP=/ecs/group12-api-staging
export WEB_LOG_GROUP=/ecs/group12-web-staging

# ---------- roles (A1 §4.4) ----------
export GITHUB_REPO=het-lathiya/Group12
export ECS_EXECUTION_ROLE_ARN="arn:aws:iam::${AWS_ACCOUNT_ID}:role/group12-ecs-execution"
export ECS_INFRASTRUCTURE_ROLE_ARN="arn:aws:iam::${AWS_ACCOUNT_ID}:role/group12-ecs-infrastructure"

# ---------- auth-only Supabase project (public values) ----------
export STAGING_SUPABASE_URL="<https://your-project.supabase.co>"
export STAGING_SUPABASE_ANON_KEY="<Supabase anon key, public by design>"
export STAGING_FEATURES_DISABLED=

# ---------- first images: set each tag after pushing the image (guide step 7 and 9) ----------
export API_IMAGE_TAG=
export WEB_IMAGE_TAG=

# ---------- recorded by 06_services.sh; leave blank ----------
export API_TASKS_SECURITY_GROUP=
export AWS_SUBNET_IDS=
export STAGING_API_SERVICE_ARN=
export STAGING_API_URL=
export STAGING_WEB_SERVICE_ARN=
export STAGING_WEB_ORIGIN=
